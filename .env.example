# --- Button+ Manager Konfiguration ---
# Diese Datei nach ".env" kopieren und anpassen.

# HTTP-Port, auf dem die Weboberfläche läuft
PORT=8080

# IP-Adresse deines Button+ Geräts im Netzwerk (für Konfig lesen/schreiben)
BUTTONPLUS_DEVICE_IP=192.168.1.50

# MQTT-Broker, mit dem sich sowohl das Gerät als auch dieses Programm verbinden
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Basis-Topic (Präfix) der Button+ Firmware. Standard: buttonplus
MQTT_BASE_TOPIC=buttonplus

# Optional: Geräte-ID (z. B. btn_4584b8). Wird sonst automatisch aus /config gelesen.
BUTTONPLUS_DEVICE_ID=

# Ablageort für gespeicherte Szenen/Einstellungen
DATA_DIR=./data
