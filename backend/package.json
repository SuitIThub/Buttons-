{
  "name": "buttonplus-manager-backend",
  "version": "1.0.0",
  "description": "Management-Backend für Button+ V2 Geräte (MQTT + lokale HTTP-API)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx verify-fixes.ts && tsx verify-runtime.ts && tsx verify-transit.ts"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.9.3",
    "jsep": "^1.4.0",
    "mqtt": "^5.10.1",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
